          "name": "refresh-invalidToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Refresh successful\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"New token received\", function () {\r",
                  "    pm.expect(response.token).to.not.be.empty;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"New refresh token received\", function () {\r",
                  "    pm.expect(response.refreshToken).to.not.be.empty;\r",
                  "});\r",
                  "\r",
                  "pm.environment.set(\"token\", response.token);\r",
                  "pm.environment.set(\"refreshToken\", response.refreshToken);\r",
                  "pm.environment.set(\"tokenExpires\", response.tokenExpires);\r",
                  "const response = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Token is returned\", function () {\r",
                  "    pm.expect(response.token).to.not.be.empty;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Refresh token is returned\", function () {\r",
                  "    pm.expect(response.refreshToken).to.not.be.empty;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Token expiration is returned\", function () {\r",
                  "    pm.expect(response.tokenExpires).to.exist;\r",
                  "});\r",
                  "pm.test(\"REFRESH-TOKEN-04 - No token should be generated\", function () {\r",
                  "    const response = pm.response.json();\r",
                  "\r",
                  "    pm.expect(response).to.not.have.property(\"token\");\r",
                  "    pm.expect(response).to.not.have.property(\"refreshToken\");\r",
                  "});\r",
                  "\r",
