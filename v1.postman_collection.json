    {
      "name": "Authentication",
      "item": [
        {
          "name": "1. Login - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "let data = pm.response.json()",
                  "",
                  "pm.test(\"Token is present in the response\", function () {",
                  "    data.token !== undefined && data.token !== \"\" && data.token !== null;",
                  "});",
                  "",
                  "pm.test(\"Refresh token is present in the response\", function () {",
                  "    data.refreshToken !== undefined && data.refreshToken !== \"\" && data.refreshToken !== null;",
                  "});",
                  "",
                  "pm.test(\"Token expiration is not in the past\", function () {",
                  "    data.tokenExpires > Date.now();",
                  "});",
                  "",
                  "pm.test(\"Email is the same as the one in the request\", function () {;",
                  "    data.user.email = pm.request.body.email;",
                  "});",
                  "const response = pm.response.json();",
                  "",
                  "pm.environment.set(\"token\", response.token);",
                  "",
                  "console.log(\"Token enregistré :\", response.token);",
                  "pm.test(\"Status code is 422\", function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "",
                  "pm.test(\"Validation failed message is present\", function () {",
                  "    const response = pm.response.json();",
                  "",
                  "    pm.expect(response.message).to.eql(\"Validation failed with errors\");",
                  "});",
                  "",
                  "pm.test(\"Title validation error is present\", function () {",
                  "    const response = pm.response.json();",
                  "",
                  "    pm.expect(response.validationErrors).to.have.property(\"title\");",
                  "});",
                  "const response = pm.response.json();",
                  "",
                  "pm.environment.set(\"token\", response.token);",
                  "pm.environment.set(\"refreshToken\", response.refreshToken);",
                  "pm.environment.set(\"tokenExpires\", response.tokenExpires);",
                  "",
                  "pm.test(\"Login successful\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Token received\", function () {",
                  "    pm.expect(response.token).to.not.be.empty;",
                  "});",
                  "",
                  "pm.test(\"Refresh token received\", function () {",
                  "    pm.expect(response.refreshToken).to.not.be.empty;",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
