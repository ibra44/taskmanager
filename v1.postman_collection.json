          "name": "CreateTask - Sucess - 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "let data = pm.response.json()",
                  "",
                  "pm.test(\"id present in the response\", function () {",
                  "    pm.expect(data.id).to.exist;",
                  "});",
                  "",
                  "pm.test(\"title is present in the response\", function () {",
                  "    pm.expect(data.title).to.not.equal(\"\");",
                  "});",
                  "",
                  "pm.test(\"description is present in the response\", function () {",
                  "    pm.expect(data.description).to.not.equal(\"\");",
                  "});",
                  "",
                  "pm.test(\"done is not true\", function () {",
                  "   pm.expect(data.done).to.be.a(\"boolean\") && pm.expect(data.done).to.be.false;",
                  "});",
                  "pm.test(\"createdAt is a valid, non-future date\", function () {",
                  "    pm.expect(data.createdAt).to.exist;",
                  "    //pm.expect(new Date(data.createdAt).getTime()).to.be.below(Date.now());",
                  "   const createdAt = new Date(data.createdAt);",
                  "const today = new Date();",
                  "",
                  "const createdDate = createdAt.toLocaleDateString('fr-FR');",
                  "const todayDate = today.toLocaleDateString('fr-FR');",
                  "",
                  "pm.expect(createdDate).to.eql(todayDate);",
                  "pm.expect(data.createdAt).to.exist;",
                  "    const parsedDate = new Date(data.createdAt);",
                  "    pm.expect(parsedDate.toString()).to.not.equal(\"Invalid Date\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
